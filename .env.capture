# Modo fixtures determinista para capturas visuales y chequeos axe/overflow.
# Se activa SOLO con un mode explícito:
#   npm run dev -- --mode capture
#   npm run build -- --mode capture
# Sin este mode, VITE_APP_FIXTURES queda sin definir y la app usa Firestore.
# No agregar datos reales ni secretos a este archivo.
VITE_APP_FIXTURES=1
